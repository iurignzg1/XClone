NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/xclone
# mínimo de 32 caracteres, ex.: openssl rand -base64 48
JWT_ACCESS_SECRET=
# opcionais (padrão: 900 = 15 min, 604800 = 7 dias e 2592000 = 30 dias)
# ACCESS_TOKEN_TTL_SECONDS=900
# REFRESH_TOKEN_TTL_SECONDS=604800
# SESSION_MAX_LIFETIME_SECONDS=2592000
